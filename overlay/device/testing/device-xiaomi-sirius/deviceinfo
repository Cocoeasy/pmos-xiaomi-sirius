# https://postmarketos.org/deviceinfo
# Please use double quotes only. You can source this file in shell scripts.
#
# Boot image layout copied from the official same-kernel ports:
#   xiaomi-pyxis  (Xiaomi Mi 9 Lite, SDM710)
#   google-sargo  (Pixel 3a, SDM670)
# Both: header version 0, append_dtb, same flash offsets.
# Neither sets header_version=2.

deviceinfo_format_version="0"
deviceinfo_name="Xiaomi Mi 8 SE"
deviceinfo_manufacturer="Xiaomi"
deviceinfo_codename="xiaomi-sirius"
deviceinfo_year="2018"
deviceinfo_arch="aarch64"

# Device related
# No DRM panel yet (EA8074 is not in the shared kernel). simple-framebuffer
# may be blank. Do not stall initramfs waiting for a display.
deviceinfo_drm="false"
deviceinfo_no_framebuffer="true"
deviceinfo_chassis="handset"
deviceinfo_screen_width="1080"
deviceinfo_screen_height="2244"
deviceinfo_rootfs_image_sector_size="4096"
deviceinfo_getty="ttyMSM0;115200"

# Bootloader related — pyxis + sargo
deviceinfo_flash_method="fastboot"
deviceinfo_generate_bootimg="true"
deviceinfo_bootimg_qcdt="false"
deviceinfo_flash_pagesize="4096"
deviceinfo_flash_offset_base="0x00000000"
deviceinfo_flash_offset_kernel="0x00008000"
deviceinfo_flash_offset_ramdisk="0x01000000"
deviceinfo_flash_offset_second="0x00000000"
deviceinfo_flash_offset_tags="0x00000100"
deviceinfo_flash_sparse="true"
deviceinfo_boot_filesystem="fat32"

# sargo: Android 9 bootloaders sometimes need a vbmeta write
deviceinfo_flash_fastboot_partition_vbmeta="vbmeta"

# Kernel: DTB is added in kernel/ then patched into linux-postmarketos-qcom-sdm670
deviceinfo_dtb="qcom/sdm710-xiaomi-sirius"
deviceinfo_append_dtb="true"
deviceinfo_flash_kernel_on_update="true"

# sargo gadget IDs (Google tether). Windows already knows this pair.
deviceinfo_usb_idVendor="0x18d1"
deviceinfo_usb_idProduct="0x4ee3"
deviceinfo_usb_network_function="rndis.usb0"
